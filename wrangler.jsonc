{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 2026-11-17 대표 요청으로 점검용 주소에 배포: https://aigame-project.taehomedian.workers.dev
  // 정식 도메인은 아직 미정 (README "출시 전에 정할 것" 1번).
  // PPOP-project 와 같은 방식: Cloudflare Workers "정적 파일(assets)" 배포 — 코드 없이 dist 만 올립니다.
  // 다시 배포: npm run deploy (= npm run build → wrangler deploy)
  "name": "aigame-project",
  "compatibility_date": "2026-11-01",
  // 운영 도메인을 붙이기 전 점검용 *.workers.dev 주소
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // 화면 주소(/pack/..., /play/...)를 새로고침해도 앱이 뜨도록 index.html 로 돌려줍니다.
    "not_found_handling": "single-page-application"
  }
}
